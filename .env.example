# Environment variables used by the project. Copy this file to .env and
# set the values. Load it when running a command:
#
#   uv run --env-file .env computeruse discover ...
#
# uv loads the file. The application does not load .env itself. Git ignores
# .env and .env.* except for this example.

# Discovery reads this key in src/computeruse/cli.py and sends it as a bearer
# token to the Responses API. Discovery requires it; review and replay do not.
OPENAI_API_KEY=

# The secret declared in evaluation/profile.yaml. The adapter resolves it
# when typing. Use this synthetic value for the local evaluation pages.
APPROVER_PASSCODE=synthetic-passcode
